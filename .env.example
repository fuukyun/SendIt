# Copy to .env and adjust. Values below are for local development only.

# --- PostgreSQL ---
POSTGRES_USER=sendit
POSTGRES_PASSWORD=sendit_dev_password
POSTGRES_DB=sendit
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sendit:sendit_dev_password@localhost:5433/sendit

# --- MinIO (dev S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Storage: MinIO through the S3 API (used by the API and, via signed URLs, the browser) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sendit
# Reuses the MinIO root account above.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_dev_secret

# --- API ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Signs password unlocks; at least 32 characters, e.g. `openssl rand -hex 32`.
APP_SECRET=dev-only-secret-change-me-in-production-0123456789
# Per-IP rate limits (kept in API memory). Keep enabled outside tests.
RATE_LIMIT_ENABLED=true

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
